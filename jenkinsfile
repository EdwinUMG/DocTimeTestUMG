pipeline {
    agent any

    environment {
        REPO_OWNER = 'EdwinUMG'
        REPO_NAME  = 'DocTimeTestUMG'
        
        // IDs de infraestructura Railway
        RAILWAY_ENV_ID          = 'd2a8413a-cdec-47b3-bc65-92a866b5c3a2'
        RAILWAY_SERVICE_BACKEND  = '436f1478-830d-4546-b8c1-cb63a4994ea0'
        RAILWAY_SERVICE_FRONTEND = 'bde9c3b3-c0d2-4b0c-b441-242059a71de8'
        RAILWAY_SERVICE_ADMIN    = 'd21a765c-4820-4626-b39d-fe61631d3ac2'
    }

    stages {
        stage('Notificar Inicio a GitHub') {
            steps {
                script {
                    updateGitHubStatus('PENDING', 'Pipeline en ejecución...')
                }
            }
        }

        // ==========================================
        // ETAPAS BACKEND
        // ==========================================
        stage('Backend: Dependencias y Tests (E10)') {
            when {
                anyOf {
                    changeset "backend/**"
                    changeset "jenkinsfile" // Si cambia el pipeline, prueba todo por seguridad
                }
            }
            steps {
                echo 'Cambios detectados en Backend. Ejecutando pruebas...'
                dir('backend') {
                    bat 'npm install'
                    bat 'npm run test:coverage'
                }
            }
        }

        // ==========================================
        // ETAPAS FRONTEND
        // ==========================================
        stage('Frontend: Dependencias y Tests') {
            when {
                anyOf {
                    changeset "frontend/**"
                    changeset "jenkinsfile"
                }
            }
            steps {
                echo 'Cambios detectados en Frontend. Ejecutando pruebas...'
                dir('frontend') {
                    bat 'npm install'
                    bat 'npm test -- --run'
                }
            }
        }

        // ==========================================
        // ETAPAS ADMIN
        // ==========================================
        stage('Admin: Dependencias y Tests') {
            when {
                anyOf {
                    changeset "admin/**"
                    changeset "jenkinsfile"
                }
            }
            steps {
                echo 'Cambios detectados en Admin. Ejecutando pruebas...'
                dir('admin') {
                    bat 'npm install'
                    bat 'npm test -- --run'
                }
            }
        }

        // ==========================================
        // CALIDAD DE CÓDIGO (SONARQUBE)
        // ==========================================
        stage('Análisis Estático SonarQube (E12)') {
            steps {
                script {
                    def scannerHome = tool 'SonarQubeScanner'
                    withSonarQubeEnv('SonarQubeLocal') {
                        bat """
                            "${scannerHome}\\bin\\sonar-scanner" ^
                            -Dsonar.projectKey=DocTime_ACS ^
                            -Dsonar.sources=backend/controllers,backend/models,backend/middlewares,frontend/src,admin/src ^
                            -Dsonar.tests=backend/tests ^
                            -Dsonar.javascript.lcov.reportPaths=backend/coverage/lcov.info
                        """
                    }
                }
            }
        }

        stage('Verificación Quality Gate (E12)') {
            steps {
                timeout(time: 2, unit: 'MINUTES') {
                    script {
                        def qg = waitForQualityGate()
                        if (qg.status != 'OK') {
                            error "Quality Gate falló con estado: ${qg.status}. Se detiene el pipeline."
                        }
                    }
                }
            }
        }

        stage('Pruebas de API Newman (E11)') {
            when {
                anyOf {
                    changeset "backend/**"
                    changeset "tests/api/**"
                    changeset "jenkinsfile"
                }
            }
            steps {
                echo 'Ejecutando pruebas de API con Newman...'
                dir('backend') {
                    bat 'npm run test:api'
                }
            }
        }

       // ==========================================
        // DESPLIEGUE CONTINUO A RAILWAY (E13)
        // ==========================================
        stage('Despliegue Continuo a Railway (E13)') {
            when {
                anyOf {
                    branch 'qa'
                    branch 'main'
                }
            }
            steps {
                withCredentials([string(credentialsId: 'railway-api-token', variable: 'RAILWAY_TOKEN')]) {
                    script {
                        echo "Rama autorizada para despliegue: ${env.BRANCH_NAME}. Procediendo con Railway..."
                        
                        // Despliegue condicional por módulo (Backend / Frontend / Admin)
                        if (currentBuild.changeSets.any { cs -> cs.any { it.affectedFiles.any { f -> f.path.startsWith('backend/') } } } || env.BRANCH_NAME == 'main') {
                            echo 'Desplegando Backend en Railway...'
                            deployToRailway(env.RAILWAY_SERVICE_BACKEND, env.RAILWAY_ENV_ID)
                        }
                        if (currentBuild.changeSets.any { cs -> cs.any { it.affectedFiles.any { f -> f.path.startsWith('frontend/') } } } || env.BRANCH_NAME == 'main') {
                            echo 'Desplegando Frontend en Railway...'
                            deployToRailway(env.RAILWAY_SERVICE_FRONTEND, env.RAILWAY_ENV_ID)
                        }
                        if (currentBuild.changeSets.any { cs -> cs.any { it.affectedFiles.any { f -> f.path.startsWith('admin/') } } } || env.BRANCH_NAME == 'main') {
                            echo 'Desplegando Admin en Railway...'
                            deployToRailway(env.RAILWAY_SERVICE_ADMIN, env.RAILWAY_ENV_ID)
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                updateGitHubStatus('SUCCESS', 'Pipeline completado con éxito.')
            }
        }
        failure {
            script {
                updateGitHubStatus('FAILURE', 'El pipeline falló en una o más etapas.')
            }
        }
    }
}

// Función auxiliar reutilizable para disparar la API de Railway
def deployToRailway(String serviceId, String environmentId) {
    powershell """
        \$headers = @{
            "Authorization" = "Bearer \$env:RAILWAY_TOKEN"
            "Content-Type"  = "application/json"
        }
        \$body = @{
            query = 'mutation { serviceInstanceDeploy(serviceId: "${serviceId}", environmentId: "${environmentId}") }'
        } | ConvertTo-Json

        \$response = Invoke-RestMethod -Uri "https://backboard.railway.app/graphql/v2" -Method Post -Headers \$headers -Body \$body
        Write-Output "Respuesta Railway: \$(\$response | ConvertTo-Json -Compress)"
    """
}

def updateGitHubStatus(String state, String description) {
    script {
        def commitSha = env.GIT_COMMIT ?: bat(script: '@git rev-parse HEAD', returnStdout: true).trim().replaceAll("[\\r\\n]", "")
        withCredentials([string(credentialsId: 'github-pat-token', variable: 'TOKEN')]) {
            bat """
                @curl -s -X POST ^
                -H "Authorization: token %TOKEN%" ^
                -H "Accept: application/vnd.github.v3+json" ^
                -H "User-Agent: Jenkins-CI" ^
                https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/statuses/${commitSha} ^
                -d "{\\\"state\\\":\\\"${state.toLowerCase()}\\\",\\\"target_url\\\":\\\"${env.BUILD_URL}\\\",\\\"description\\\":\\\"${description}\\\",\\\"context\\\":\\\"continuous-integration/jenkins/pr-validation\\\"}"
            """
        }
    }
}